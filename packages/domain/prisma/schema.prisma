// Canonical data model — packages/domain
//
// Phase 2.3 (Application User & Workspace Foundation) — see
// docs/identity/identity-data-model.md (design) and
// docs/identity/phase-2-3-implementation-report.md (this implementation).
//
// Phase 3.1 (Meta OAuth & Connection) — see docs/meta/meta-connection-model.md (design) and
// docs/meta/phase-3-1-implementation-report.md (this implementation). Adds MetaConnection
// only — one row per workspace (OD-3A-04), credential material encrypted at the application
// layer (meta-token-security.md §2), never exposed through any API response.
//
// Phase 3.2 (Meta Business & Ad Account Discovery) — see docs/meta/meta-account-discovery.md
// (design) and docs/meta/phase-3-2-implementation-report.md (this implementation). Adds
// AdAccount only — discovery itself is never persisted; a row exists only once a user has
// explicitly selected an account. No separate Business table (meta-account-discovery.md's
// "do not persist businesses automatically unless the approved data model requires it" — it
// does not; Business display metadata is denormalized onto AdAccount instead).
//
// Deliberately NOT modeled here (per meta-architecture.md and this phase's own Hard
// Restrictions): campaigns, ad_sets, ads, creatives, insights, webhook_events,
// conversations, messages, ai_runs, ai_tool_calls, actions, approvals, goals,
// optimization_*, reports — all deferred to the phases that own them (Phase 4+). AuditEvent
// below is scoped ONLY to identity/workspace lifecycle events plus Meta connection lifecycle
// events (identity-api-contracts.md §3, meta-architecture.md §5), not the full future
// business audit system.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

/// Application-owned role set — rbac.md §1. NOT Clerk's Organization role; never derived
/// from Clerk data (clerk-integration.md finding #6, identity-sync.md §1).
enum Role {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AuditActorType {
  USER
  SYSTEM
  WEBHOOK
  RECONCILIATION
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// One row per Clerk-authenticated human — identity-data-model.md §2.
model User {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// External identity reference only — never used as an authorization key on its own
  /// (authorization.md §2's external-ID rule applied to identity).
  clerkUserId String  @unique @map("clerk_user_id")
  email       String?
  displayName String? @map("display_name")

  /// Soft-delete marker — identity-sync.md §5 (a deleted Clerk user's row is retained,
  /// never hard-deleted, to preserve audit/action attribution).
  deletedAt DateTime? @map("deleted_at")

  /// Set only by webhook/reconciliation sync — the out-of-order-event timestamp guard
  /// (identity-sync.md §3: "uses event timestamp, not arrival order").
  clerkSyncedAt DateTime? @map("clerk_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships WorkspaceMembership[]

  @@map("users")
}

/// The tenant boundary — workspace-model.md §1, multi-tenancy.md §1.
model Workspace {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// 1:1 with a Clerk Organization (workspace-model.md §2) — nullable because a workspace
  /// row must never be created without this reference under Phase 2.3's sync-only creation
  /// model (see phase-2-3-implementation-report.md), but the column itself stays nullable
  /// to match the approved design's own stated nullability rather than tightening it here.
  clerkOrganizationId String? @unique @map("clerk_organization_id")

  name          String
  status        WorkspaceStatus @default(ACTIVE)
  timezone      String?
  /// Non-relational settings only (identity-data-model.md §2) — never an authorization fact.
  configuration Json            @default("{}")

  clerkSyncedAt DateTime? @map("clerk_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    WorkspaceMembership[]
  auditEvents    AuditEvent[]
  metaConnection MetaConnection?
  adAccounts     AdAccount[]

  @@map("workspaces")
}

/// Join row: (user, workspace) → role, status — workspace-model.md §1. Carries the Role,
/// not User or Workspace alone.
model WorkspaceMembership {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  role   Role
  status MembershipStatus @default(ACTIVE)

  clerkSyncedAt DateTime? @map("clerk_synced_at")
  removedAt     DateTime? @map("removed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides MembershipPermissionOverride[]

  /// One user cannot have duplicate membership in a workspace (Phase 2.3 Step 2 invariant).
  @@unique([workspaceId, userId])
  /// "Which workspaces does this user belong to" — identity-data-model.md §4.
  @@index([userId])
  /// Active membership lookups per workspace — identity-data-model.md §4.
  @@index([workspaceId, status])
  @@map("workspace_memberships")
}

/// The permission catalog — rbac.md §3. Queryable data, not hardcoded conditionals
/// (identity-data-model.md §1).
model Permission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String @unique
  resourceGroup String @map("resource_group")

  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  overrides       MembershipPermissionOverride[]

  @@map("permissions")
}

/// The queryable form of the rbac.md §3 role→permission matrix.
model RolePermission {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         Role
  permissionId String @map("permission_id") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

/// Schema placeholder only — rbac.md §5 (DEFERRED, OD-05). Not populated or read by any
/// code in Phase 2.3.
model MembershipPermissionOverride {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String  @map("membership_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  granted      Boolean

  createdAt DateTime @default(now()) @map("created_at")

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission          @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permissionId])
  @@map("membership_permission_overrides")
}

/// Identity/workspace lifecycle audit trail only (identity-api-contracts.md §3,
/// AUDIT_LOGGING.md/SEC-012's required metadata). NOT the full future business audit
/// system (campaigns/actions/approvals, etc. — identity-data-model.md §3 defers that).
model AuditEvent {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String? @map("workspace_id") @db.Uuid

  actorType AuditActorType @map("actor_type")
  /// Our internal User.id when actorType = USER; a stable descriptive string (e.g.
  /// "clerk-webhook", "clerk-reconciliation") for SYSTEM/WEBHOOK/RECONCILIATION; null when
  /// truly unattributable (never the case for USER-actor events).
  actorId   String?        @map("actor_id")

  eventType    String
  resourceType String?      @map("resource_type")
  resourceId   String?      @map("resource_id")
  action       String
  outcome      AuditOutcome

  correlationId String? @map("correlation_id")
  /// Safe metadata only — SEC-012 "Never Log": no tokens, secrets, or full payloads.
  metadata      Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([eventType])
  @@map("audit_events")
}

enum MetaConnectionStatus {
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  DISCONNECTED
  ERROR
}

/// A workspace's connection to Meta's Marketing API — meta-connection-model.md. One
/// connection per workspace (OD-3A-04, phase-3-owner-decision-package.md) — reconnecting
/// updates this row in place rather than creating a second one, incrementing
/// `connectionVersion`. Credential material is encrypted at the application layer (AES-256-
/// GCM, meta-token-security.md §2) — the ciphertext/iv/authTag columns are never returned
/// through any API response (meta-connection-model.md §1's sensitivity table).
model MetaConnection {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @unique @map("workspace_id") @db.Uuid

  provider       String @default("meta")
  /// Meta's own user ID (from `GET /me`) — external identity only, never an authorization
  /// key on its own (meta-resource-model.md §1).
  externalUserId String @map("external_user_id")

  /// AES-256-GCM ciphertext of the long-lived Meta access token. Only the Meta adapter
  /// layer ever decrypts this (meta-token-security.md §2's "only the Meta integration
  /// service" rule). Nullable — a DISCONNECTED connection has this credential material
  /// actually deleted, not merely marked inactive (OD-3A-05's binding engineering rule:
  /// "credential material must be revoked/deleted promptly on disconnect").
  credentialCiphertext Bytes? @map("credential_ciphertext")
  credentialIv         Bytes? @map("credential_iv")
  credentialAuthTag    Bytes? @map("credential_auth_tag")

  scopes         String[]
  tokenExpiresAt DateTime? @map("token_expires_at")

  status                  MetaConnectionStatus @default(CONNECTED)
  lastValidatedAt         DateTime?            @map("last_validated_at")
  lastSuccessfulApiCallAt DateTime?            @map("last_successful_api_call_at")
  /// Normalized error category only (meta-error-model.md §1) — never a raw Meta error body.
  errorState              String?              @map("error_state")
  /// Increments on every reconnection (meta-connection-model.md §1).
  connectionVersion       Int                  @default(1) @map("connection_version")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  disconnectedAt DateTime? @map("disconnected_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccounts AdAccount[]

  @@map("meta_connections")
}

/// A workspace's own selection lifecycle for a discovered Ad Account (meta-account-
/// discovery.md §4) — distinct from Meta's own `account_status` (see `accountStatus` below).
/// `DESELECTED` is a soft state, never a row deletion (BR-018/OD-3A-05) — re-selecting the
/// same external account updates this row back to `ACTIVE` rather than creating a duplicate
/// (meta-account-discovery.md §3's "updates the existing row... rather than creating a
/// duplicate", applied here to selection the same way it already applies to reconnection).
enum AdAccountSelectionStatus {
  ACTIVE
  DESELECTED
}

/// A workspace-authorized Meta Ad Account (meta-resource-model.md §4, meta-account-
/// discovery.md). Discovery itself is never persisted (meta-account-discovery.md §2) — a row
/// here exists only once a user has explicitly selected the account. Every lookup is scoped
/// `workspace_id + external_id` (meta-resource-model.md §1-2) — the external Meta ID is never
/// an authorization key on its own (meta-threat-model.md #7-#8).
model AdAccount {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String @map("workspace_id") @db.Uuid
  metaConnectionId String @map("meta_connection_id") @db.Uuid

  /// Meta's own `act_{id}` identifier (round-trips directly into Graph API calls) — external
  /// identity only, never an authorization key on its own (meta-resource-model.md §1).
  externalId    String @map("external_id")
  name          String
  currency      String
  timezone      String @map("timezone")
  /// Normalized from Meta's numeric `account_status` (meta-error-model.md §1's normalization
  /// discipline, applied here to account status rather than only to errors) — e.g. `ACTIVE`,
  /// `DISABLED`, `CLOSED`, or `UNKNOWN` for any code this application doesn't yet recognize
  /// (fail-safe: never crashes discovery over an unrecognized future Meta status code).
  accountStatus String @map("account_status")

  /// Denormalized Business display metadata (meta-resource-model.md §4's "business
  /// association") — nullable: a directly-shared ad account may have no Business at all.
  /// Never a separate `Business` table — the approved architecture does not require
  /// persisting Business entities on their own (meta-account-discovery.md's "Do not persist
  /// businesses automatically unless the approved data model requires it" — it does not).
  businessExternalId String? @map("business_external_id")
  businessName       String? @map("business_name")

  status       AdAccountSelectionStatus @default(ACTIVE)
  selectedAt   DateTime                 @default(now()) @map("selected_at")
  deselectedAt DateTime?                @map("deselected_at")
  /// Set only once Phase 4.1's sync worker exists (meta-sync.md §1) — this phase never writes
  /// it, the column exists now so Phase 4.1 needs no further schema change.
  lastSyncedAt DateTime?                @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metaConnection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)

  /// The mechanical tenant-isolation/deduplication rule (meta-resource-model.md §2): the same
  /// Meta external ID can exist independently in two different workspaces without collision,
  /// and a re-selection of an already-selected account updates this row instead of
  /// duplicating it.
  @@unique([workspaceId, externalId])
  @@index([workspaceId, status])
  @@index([metaConnectionId])
  @@map("ad_accounts")
}

/// Minimal event envelope for webhook idempotency — identity-sync.md §2 step 3/6. Keyed by
/// the Standard Webhooks `svix-id` header, i.e. Clerk's own event ID. Deliberately does NOT
/// store the payload (identity-sync.md's "only sync what you need" + data-minimization) —
/// reconciliation (identity-sync.md §4) is the backstop for anything this envelope alone
/// can't recover.
model ClerkWebhookEvent {
  id          String             @id
  eventType   String             @map("event_type")
  status      WebhookEventStatus @default(RECEIVED)
  failureNote String?            @map("failure_note")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("clerk_webhook_events")
}
