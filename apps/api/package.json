{
  "name": "@ai-marketing-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./src/server.ts",
    "./app": "./src/app.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-marketing-manager/config": "workspace:*",
    "@ai-marketing-manager/contracts": "workspace:*",
    "@ai-marketing-manager/domain": "workspace:*",
    "@ai-marketing-manager/queue": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
