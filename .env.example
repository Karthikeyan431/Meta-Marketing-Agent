# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is gitignored. This file must only ever contain placeholders.
#
# Scope: Phase 1 (Foundation) services, plus Phase 2.1 Clerk readiness placeholders below
# (no real values — Clerk authentication itself is not implemented until a later Phase 2
# slice, per docs/identity/phase-2-1-implementation-report.md). OpenAI/Meta variables are
# intentionally NOT listed here yet; they are out of scope until Phase 3 (Meta Connection)
# and Phase 8 (AI Read-Only) respectively.

# ---- Shared (every service) ----
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# ---- Database (packages/domain, apps/api) ----
# Local dev default matches infrastructure/docker-compose.yml's postgres service
# (mapped to host port 5433 to avoid clashing with a locally installed PostgreSQL).
DATABASE_URL=postgresql://app:app_local_only@localhost:5433/ai_marketing_manager

# ---- Redis (apps/api, workers/*) ----
# Local dev default matches infrastructure/docker-compose.yml's redis service (mapped to
# host port 6380 — on some machines another process already owns IPv6 loopback 6379,
# which causes confusing intermittent connection resets; see docker-compose.yml's comment).
REDIS_URL=redis://localhost:6380

# ---- apps/api ----
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Clerk (apps/web) — PLACEHOLDERS ONLY, per docs/identity/clerk-integration.md §1
# finding #10. No real Clerk application exists yet; do not put real keys here. Required
# for @clerk/nextjs to initialize at all once Phase 2.2 wires it into the app.
# Deliberately not shaped like a real Clerk key (pk_test_.../sk_test_...) — a value in that
# shape trips secret-scanner false positives (e.g. gitleaks' stripe-access-token rule,
# since Clerk and Stripe share the pk_/sk_ prefix convention) even when it's just a
# placeholder.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-real-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-real-clerk-secret-key
# Reserved for the webhook handler designed in docs/identity/identity-sync.md §2 — not
# implemented in Phase 2.1; kept here only so the variable name is settled in advance.
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-real-clerk-webhook-signing-secret

# ---- workers/* (each worker also reads REDIS_URL above) ----
# Defaults differ per worker if HEALTH_PORT is not set explicitly:
#   sync=4101 insights=4102 optimization=4103 report=4104 webhook=4105 maintenance=4106
WORKER_CONCURRENCY=5
